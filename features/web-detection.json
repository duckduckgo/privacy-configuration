{
    "_meta": {
        "description": "Detect web patterns such as adwalls."
    },
    "state": "disabled",
    "exceptions": [],
    "settings": {
        "detectors": {
            "adwalls": {
                "generic_en": {
                    "match": {
                        "text": [
                            {
                                "pattern": [
                                    "ad ?block(er)? detected",
                                    "adjust(ing)?( your)? ad blocking settings",
                                    "(turn(ing)? off|disable|disabling|deactivate)( your| my)? ad ?block(er)?",
                                    "your ad ?blocker is on",
                                    "you('re| are| may be) using an ad blocker"
                                ]
                            },
                            {
                                "pattern": [
                                    "^\\s*allow ads\\s*$"
                                ],
                                "selector": "button"
                            }
                        ]
                    }
                },
                "generic_de": {
                    "match": {
                        "text": {
                            "pattern": [
                                "deaktivieren sie ihren adblocker",
                                "deaktivieren sie ihre blocker",
                                "adblocker zu deaktivieren",
                                "adblocker deaktivieren",
                                "sie einen adblocker verwenden"
                            ]
                        }
                    }
                },
                "generic_es": {
                    "match": {
                        "text": {
                            "pattern": [
                                "en esta web no aceptamos el uso de adblock",
                                "bloqueador de anuncios"
                            ]
                        }
                    }
                },
                "generic_it": {
                    "match": {
                        "text": {
                            "pattern": [
                                "disattiva l'ad block",
                                "stai usando un ad block"
                            ]
                        }
                    }
                },
                "generic_nl": {
                    "match": {
                        "text": {
                            "pattern": [
                                "adblock gedetecteerd",
                                "schakel je adblocker uit om de video te bekijken"
                            ]
                        }
                    }
                },
                "generic_se": {
                    "match": {
                        "text": {
                            "pattern": [
                                "har du en annonsblockerare igång",
                                "avaktivera din annonsblockerare"
                            ]
                        }
                    }
                },
                "admiral": {
                    "match": {
                        "text": {
                            "pattern": [
                                "contact support"
                            ],
                            "selector": [
                                "a[href*='forms.gle/6M6VTS3mmHXGbFjM8']",
                                "a[href^='http://forms.gle/6M6VTS3mmHXGbFjM8']",
                                "a[href^='https://forms.gle/6M6VTS3mmHXGbFjM8']"
                            ]
                        }
                    }
                }
            },
            "captcha": {
                "recaptcha": {
                    "state": "disabled",
                    "match": {
                        "element": {
                            "selector": [
                                ".g-rec\\61 ptcha",
                                "iframe[src*='rec\\61 ptcha']",
                                "iframe[title*='rec\\61 ptcha' i]"
                            ],
                            "visibility": "content"
                        }
                    }
                },
                "hcaptcha": {
                    "state": "disabled",
                    "match": {
                        "element": {
                            "selector": [
                                ".h-c\\61 ptcha",
                                "iframe[src*='hc\\61 ptcha.com']",
                                "iframe[title*='hc\\61 ptcha' i]"
                            ],
                            "visibility": "content"
                        }
                    }
                },
                "turnstile": {
                    "state": "disabled",
                    "match": {
                        "element": {
                            "selector": [
                                ".cf-t\\75 rnstile:not(#t\\75 rnstile-wrapper)",
                                ".cf-t\\75 rnstile:not(#t\\75 rnstile-wrapper) iframe",
                                "iframe[src*='challenges.clo\\75 dfl\\61 re.com/t\\75 rnstile']"
                            ],
                            "visibility": "content"
                        }
                    }
                },
                "cloudflare": {
                    "state": "disabled",
                    "match": {
                        "element": {
                            "selector": [
                                "#ch\\61 llenge-form",
                                "#cf-wr\\61 pper",
                                ".cf-browser-verific\\61 tion",
                                "#ch\\61 llenge-running",
                                "#cf-ch\\61 llenge-running",
                                "#ch\\61 llenge-stage"
                            ],
                            "visibility": "content"
                        }
                    }
                },
                "datadome": {
                    "state": "disabled",
                    "match": {
                        "element": {
                            "selector": [
                                "iframe[src*='c\\61 ptcha-delivery.com']",
                                "iframe[title*='d\\61 tadome' i]"
                            ],
                            "visibility": "content"
                        }
                    }
                },
                "imperva": {
                    "state": "disabled",
                    "match": {
                        "any": [
                            {
                                "text": {
                                    "selector": [
                                        "title",
                                        "body"
                                    ],
                                    "pattern": [
                                        "Pardon Our Interruption",
                                        "protected and accelerated by Imperva",
                                        "Additional security check is required"
                                    ]
                                }
                            },
                            {
                                "element": {
                                    "selector": [
                                        "iframe[src*='_Inc\\61 psul\\61 _Resource']"
                                    ],
                                    "visibility": "content"
                                }
                            }
                        ]
                    }
                },
                "arkose": {
                    "state": "disabled",
                    "match": {
                        "element": {
                            "selector": [
                                "iframe[src*='\\61 rkosel\\61 bs.com']",
                                "iframe[src*='func\\61 ptcha.com']",
                                "#FunC\\61 ptcha-Token",
                                "[d\\61 ta-pkey]"
                            ],
                            "visibility": "content"
                        }
                    }
                },
                "geetest": {
                    "state": "disabled",
                    "match": {
                        "element": {
                            "selector": [
                                "iframe[src*='geet\\65 st.com']",
                                ".geet\\65 st_box",
                                ".geet\\65 st_c\\61 ptcha",
                                "[class*='geet\\65 st_']"
                            ],
                            "visibility": "content"
                        }
                    }
                },
                "awswaf": {
                    "state": "disabled",
                    "match": {
                        "element": {
                            "selector": [
                                "iframe[src*='c\\61 ptcha.awsw\\61 f.com']",
                                "iframe[src*='token.awsw\\61 f.com']"
                            ],
                            "visibility": "content"
                        }
                    }
                },
                "perimeterx": {
                    "state": "disabled",
                    "match": {
                        "any": [
                            {
                                "element": {
                                    "selector": [
                                        "#px-c\\61 ptcha",
                                        "iframe[src*='px-c\\64 n.net']",
                                        "iframe[src*='px-clo\\75 d.net']"
                                    ],
                                    "visibility": "content"
                                }
                            },
                            {
                                "text": {
                                    "selector": [
                                        "title",
                                        "body"
                                    ],
                                    "pattern": [
                                        "Access to this page has been denied",
                                        "we believe you are using automation tools"
                                    ]
                                }
                            }
                        ]
                    }
                },
                "other": {
                    "match": {
                        "text": {
                            "pattern": [
                                "press (and|&) hold to (confirm|verify)",
                                "slide( right)? to (verify|complete)",
                                "complete the security check to (access|continue)"
                            ]
                        }
                    }
                }
            },
            "commentsDisabled": {

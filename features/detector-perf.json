{
    "_meta": {
        "description": "Measures on-device detector execution time (worst single run, total per frame, combined across detectors) and reports threshold-crossing counts through EventHub telemetry. Thresholds are discovery bin edges, not performance budgets; edges are encoded into event-type names and must match the eventHub telemetry sources (enforced by tests/detector-perf-tests.js). No base state on purpose: platforms opt in via overrides/. On Apple, measurement is additionally gated by additionalCheck, which is disabled for everyone except the contentScopeExperiment9 treatment cohort."
    },
    "exceptions": [],
    "settings": {
        "defaults": {
            "singleRunThresholdsMs": [
                8,
                16,
                50,
                150
            ],
            "totalPerPageThresholdsMs": [
                50,
                100,
                250,
                500
            ]
        },
        "combinedThresholdsMs": [
            100,
            250,
            500
        ],
        "singleRunSevereThresholdMs": 150,
        "totalPerPageSevereThresholdMs": 500,
        "combinedSevereThresholdMs": 500,
        "detectorOverrides": {},
        "maxSeverePerPage": 10,
        "conditionalChanges": [
            {
                "condition": {
                    "injectName": "apple-isolated"
                },
                "patchSettings": [
                    {
                        "op": "add",
                        "path": "/additionalCheck",
                        "value": "disabled"
                    }
                ]
            },
            {
                "condition": {
                    "injectName": "apple-isolated",
                    "experiment": {
                        "experimentName": "contentScopeExperiment9",
                        "cohort": "treatment"
                    }
                },
                "patchSettings": [
                    {
                        "op": "add",
                        "path": "/additionalCheck",
                        "value": "enabled"
                    }
                ]
            }
        ]
    }
}
